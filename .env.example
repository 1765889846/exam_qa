# ── 对话 LLM（OpenAI 兼容）────────────────────────────────
LLM_API_KEY=your-chat-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ── Embedding（向量化，与 LLM 独立配置）──────────────────────
# provider: local（本地 sentence-transformers）| openai（OpenAI 兼容 API）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 以下留空则回退使用 LLM_API_KEY / LLM_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT=60

# 使用远程 Embedding API 示例：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Storage ────────────────────────────────────────────────
CHROMA_PATH=./storage/chroma
SQLITE_PATH=./storage/meta.db
LOG_PATH=./storage/app.log
KNOWLEDGE_DIR=data/knowledge

# ── API ────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── App ────────────────────────────────────────────────────
PORT=8787
MAX_UPLOAD_MB=50
DEBUG=false

# ── 网络代理（LLM / Embedding API / Hugging Face 下载）──────
# 留空表示不走代理；示例：http://127.0.0.1:7890
PROXY_URL=
NO_PROXY=127.0.0.1,localhost

# ── 文档解析 ───────────────────────────────────────────────
# PDF OCR：扫描版 PDF 自动识别（需系统安装 Tesseract 及语言包）
PDF_USE_OCR=true
PDF_FORCE_OCR=false
PDF_OCR_LANGUAGE=eng+chi_sim
